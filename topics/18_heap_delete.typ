= Сложность и свойства

#facts(
  ([Время], [
    #ptable(
      columns: (2.8fr, 1.4fr, 3fr),
      header: ([Операция], [Время], [Комментарий]),
      [Удаление по индексу $i$], [$O(log n)$], [Один `SiftUp` или один `SiftDown`],
      [Удаление максимума (`ExtractMax`)], [$O(log n)$], [Частный случай $i = 0$],
      [Поиск индекса по значению], [$Theta(n)$], [В пирамиде нет порядка между ветвями],
      [Удаление по значению без таблицы позиций], [$Theta(n)$], [Поиск доминирует],
      [Удаление по значению с таблицей позиций], [$O(log n)$], [Индекс известен за $O(1)$ (билет № 19)],
    )
  ]),
  ([Память], [$O(1)$ дополнительной (итеративные просеивания); при таблице позиций — $Theta(n)$.]),
  ([Структура данных], [Массив с неявной бинарной пирамидой; для удаления по значению — ещё таблица «значение (идентификатор) $->$ индекс в пирамиде».]),
  ([Ограничения], [Пирамида не умеет искать: без индекса элемент приходится искать линейно. Удаление нарушает форму дерева, если брать не последний элемент (дерево перестанет быть полным), поэтому берут именно последний. Неустойчива.]),
  ([Применимость], [Отмена задач в планировщике; удаление устаревших событий в симуляции; снятие элемента из очереди с приоритетом (билет № 19); «ленивое» удаление как альтернатива.]),
)

#remark[
  Альтернатива — _увеличить значение элемента до $+infinity$_ (элемент поднимется в корень
  за $O(log n)$) и выполнить `ExtractMax`. Это тот же результат за $O(log n)$ без
  разбора случаев, но с двумя просеиваниями.
]

= Код

#listing(caption: [Удаление по индексу (метод класса `MaxHeap` из билета № 15)])[
  ```cpp
  void Erase(int i) {
      assert(0 <= i && i < (int)a_.size());
      int last = (int)a_.size() - 1;
      if (i == last) {                       // удаляем последний — просеивать нечего
          a_.pop_back();
          return;
      }
      a_[i] = a_[last];                      // последний элемент — на место удаляемого
      a_.pop_back();
      if (i > 0 && a_[(i - 1) / 2] < a_[i]) {
          SiftUp(i);                         // больше родителя
      } else {
          SiftDown(i);                       // иначе, возможно, меньше детей
      }
  }
  ```
]

