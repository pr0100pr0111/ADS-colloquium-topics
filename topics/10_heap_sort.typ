= Код

#listing(caption: [Обычная пирамидальная сортировка с памятью O(n)])[
  ```cpp
  #include <vector>
  #include <queue>
  #include <functional>

  // Обычная пирамидальная сортировка через min-кучу: Время O(n log n), Память O(n)
  std::vector<int> HeapSortOrdinary(const std::vector<int>& a) {
      int n = (int)a.size();
      if (n <= 1) return a;

      // Фаза 1: построение min-кучи за Theta(n)
      std::priority_queue<int, std::vector<int>, std::greater<int>> min_heap(a.begin(), a.end());

      // Фаза 2: последовательное извлечение n минимумов в результирующий массив
      std::vector<int> res;
      res.reserve(n);
      while (!min_heap.empty()) {
          res.push_back(min_heap.top()); // чтение текущего минимума, O(1)
          min_heap.pop();                // извлечение и SiftDown, O(log k)
      }
      return res;
  }
  ```
]

