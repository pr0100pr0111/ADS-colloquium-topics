    [`BinarySearch` (итеративный)], [$O(1)$], [Только `left`, `right`, `mid`],
    [`BinarySearch` (рекурсивный)], [$O(log n)$], [Глубина стека $log n$],
    [`Factorial`], [$O(n)$], [Глубина стека $n$],
    [`Halves` (два вызова на $n/2$)], [$O(log n)$], [Глубина $log n$; ветви выполняются последовательно],
    [`Fibonacci` (наивный)], [$O(n)$], [Глубина стека $n$, хотя вызовов $Theta(phi^n)$],
    [`DynArray::PushBack`], [$O(n)$], [Новый буфер ёмкости $2 dot "capacity"$],
  ),
  caption: [Дополнительная память разобранных фрагментов],
)

#remark[
  Число рекурсивных вызовов (время) и глубина рекурсии (память) — разные
  величины. У наивного `Fibonacci` время экспоненциальное, а память линейная.
]

