#show: ticket.with(number: 15, title: "ДП: рюкзак")

#quick[
  Рюкзак 0/1: есть $n$ предметов с весами $w_i$ и стоимостями $c_i$, вместимость $W$; каждый
  предмет берут не более одного раза; максимизировать стоимость при весе $<= W$. Состояние
  $"dp"[i][j]$ — лучшая стоимость из первых $i$ предметов при вместимости $j$; переход — «не
  взять / взять». Время $Theta(n W)$ (_псевдополиномиально_), память $Theta(n W)$ с
  восстановлением набора или $O(W)$ без него (одна строка, $j$ по убыванию).
]

= Логика работы

- _Состояние:_ $"dp"[i][j]$ — максимальная стоимость из первых $i$ предметов при вместимости $j$.
- _База:_ $"dp"[0][j] = 0$.
- _Переход:_ $"dp"[i][j] = max("dp"[i-1][j], thick "dp"[i-1][j - w_i] + c_i)$; второй вариант при $j >= w_i$.
- _Ответ:_ $"dp"[n][W]$; набор предметов — обратным ходом: если $"dp"[i][j] != "dp"[i-1][j]$, предмет $i$ взят,
  $j := j - w_i$.
- _Экономия памяти:_ одна строка `dp[0..W]`, $j$ перебирается _по убыванию_.

#example(name: [Предметы $(w, c)$: $(2, 3)$, $(3, 4)$, $(4, 5)$, $(5, 6)$; $W = 5$])[
  #ptable(
    columns: (1.6fr, 0.7fr, 0.7fr, 0.7fr, 0.7fr, 0.7fr, 0.7fr),
    align: (left, center, center, center, center, center, center),
    header: ([$i$ \\ $j$], [0], [1], [2], [3], [4], [5]),
    [0 (нет предметов)], [0], [0], [0], [0], [0], [0],
    [1: $(2, 3)$], [0], [0], [3], [3], [3], [3],
    [2: $(3, 4)$], [0], [0], [3], [4], [4], [7],
    [3: $(4, 5)$], [0], [0], [3], [4], [5], [7],
    [4: $(5, 6)$], [0], [0], [3], [4], [5], [7],
  )
  Ответ $"dp"[4][5] = 7$. Восстановление: $"dp"[4][5] = "dp"[3][5] = "dp"[2][5]$ — предметы 4 и 3 не взяты;
  $"dp"[2][5] = 7 != "dp"[1][5] = 3$ — предмет 2 взят, $j = 2$; $"dp"[1][2] = 3 != 0$ — предмет 1 взят.
  Набор: предметы 1 и 2 (вес $5$, стоимость $7$).
]

#pitfall(title: "Порядок цикла по $j$")[
  В одномерном варианте $j$ идёт по _убыванию_. По возрастанию `dp[j - w]` уже учитывает текущий
  предмет, и получится рюкзак с неограниченным числом предметов каждого вида.
]

= Сложность и свойства

#facts(
  ([Время], [$Theta(n W)$: $n W$ состояний, переход $O(1)$.]),
  ([Память], [$Theta(n W)$ с восстановлением набора; $O(W)$ для одной стоимости (одна строка).]),
  ([Структура данных], [Двумерный массив (или одна строка) значений.]),
  ([Ограничения], [_Псевдополиномиальный_ алгоритм: время зависит от значения $W$, а не от длины записи; при $W approx 2^64$ непригоден; задача NP-трудна. Веса — целые неотрицательные. Жадность по удельной стоимости рюкзак 0/1 не решает (годится для дробного рюкзака).]),
  ([Применимость], [Выбор набора при ограничении ресурса (бюджет, вес, время), разбиение на равные суммы, задача о сумме подмножества (стоимость = вес), неограниченный рюкзак (внутренний цикл по возрастанию).]),
)

= Код

#listing(caption: [Рюкзак 0/1: стоимость за $O(W)$ памяти и набор предметов])[
  ```cpp
  #include <algorithm>
  #include <vector>

  // Только максимальная стоимость, одна строка таблицы.
  int Knapsack(const std::vector<int>& w, const std::vector<int>& c, int W) {
      std::vector<int> dp(W + 1, 0);
      for (int i = 0; i < (int)w.size(); ++i) {
          for (int j = W; j >= w[i]; --j) {          // j по убыванию: предмет берём не более раза
              dp[j] = std::max(dp[j], dp[j - w[i]] + c[i]);
          }
      }
      return dp[W];
  }

  // Двумерная таблица: восстановление набора предметов (индексы с нуля).
  std::vector<int> KnapsackItems(const std::vector<int>& w, const std::vector<int>& c, int W) {
      int n = (int)w.size();
      std::vector<std::vector<int>> dp(n + 1, std::vector<int>(W + 1, 0));
      for (int i = 1; i <= n; ++i) {
          for (int j = 0; j <= W; ++j) {
              dp[i][j] = dp[i - 1][j];                               // не берём предмет i
              if (j >= w[i - 1])
                  dp[i][j] = std::max(dp[i][j], dp[i - 1][j - w[i - 1]] + c[i - 1]);   // берём
          }
      }
      std::vector<int> items;
      for (int i = n, j = W; i > 0; --i) {
          if (dp[i][j] != dp[i - 1][j]) {                            // предмет i был взят
              items.push_back(i - 1);
              j -= w[i - 1];
          }
      }
      return items;
  }
  ```
]

= Вопросы экзаменатора

*Обязательные.*

#qa(
  ([Сформулируйте задачу о рюкзаке 0/1.], [Выбрать подмножество предметов с суммарным весом $<= W$ и максимальной суммарной стоимостью; каждый предмет не более одного раза.]),
  ([Рекуррентность?], [$"dp"[i][j] = max("dp"[i-1][j], "dp"[i-1][j - w_i] + c_i)$; второй вариант при $j >= w_i$.]),
  ([База и ответ?], [$"dp"[0][j] = 0$; ответ $"dp"[n][W]$.]),
  ([Сложность?], [Время $Theta(n W)$; память $Theta(n W)$ или $O(W)$.]),
  ([Как восстановить набор?], [Обратным ходом: если $"dp"[i][j] != "dp"[i-1][j]$, предмет $i$ взят, $j -= w_i$.]),
  ([Как сократить память?], [Одна строка, $j$ по убыванию; набор при этом восстановить нельзя.]),
)

*С подвохом.*

#qa(
  ([Почему «псевдополиномиальный»?], [Время зависит от _значения_ $W$, а не от длины его записи $log_2 W$; для $W approx 2^64$ непригодно. Задача NP-трудна.]),
  ([Почему $j$ по убыванию?], [Чтобы `dp[j - w]` ещё относилось к предыдущему предмету. По возрастанию получится неограниченный рюкзак.]),
  ([Решает ли жадность по удельной стоимости?], [Нет: $(w, c) = (10, 60), (20, 100), (30, 120)$, $W = 50$: жадность даёт $160$, оптимум $220$ (предметы 2 и 3). Для дробного рюкзака жадность верна.]),
  ([Как решить неограниченный рюкзак?], [Одномерный массив, $j$ по _возрастанию_: предмет можно брать повторно.]),
  ([Что если веса вещественные или очень большие?], [Таблицу по весу построить нельзя; нужен другой подход (перебор с отсечениями, переход к состоянию «по стоимости»: $"dp"[i][v]$ — минимальный вес для стоимости $v$).]),
  ([Что такое «сумма подмножества»?], [Рюкзак, где стоимость равна весу: можно ли набрать ровно $S$; булев массив, $O(n S)$.]),
)

#appendix[
  #proposition[Рекуррентность рюкзака 0/1 корректна.]
  #proof[
    Рассмотрим оптимальный набор из первых $i$ предметов при вместимости $j$. Если предмет $i$ в него не входит,
    это оптимальный набор из первых $i - 1$ предметов при той же вместимости: $"dp"[i-1][j]$. Если входит
    (при $j >= w_i$), остальные предметы образуют оптимальный набор из первых $i - 1$ предметов при вместимости
    $j - w_i$ (иначе его можно улучшить), и стоимость равна $"dp"[i-1][j - w_i] + c_i$. Оптимум — максимум из двух случаев.
  ]

  #proposition[Одномерный вариант с $j$ по убыванию корректен.]
  #proof[
    При обработке предмета $i$ значение `dp[j]` обновляется через `dp[j - w_i]` с меньшим индексом. Так как $j$ убывает,
    `dp[j - w_i]` ещё не обновлено на этом шаге и равно $"dp"[i-1][j - w_i]$. Значит, одномерная таблица
    совпадает со строкой двумерной, и предмет учитывается не более одного раза.
  ]

  #proposition[Жадность по удельной стоимости не оптимальна.]
  #proof[
    Предметы $(10, 60)$, $(20, 100)$, $(30, 120)$, $W = 50$; удельные стоимости $6, 5, 4$. Жадность берёт
    первые два (вес 30, стоимость 160), третий не помещается ($30 + 30 > 50$). Набор из второго и третьего
    весит 50 и стоит 220 $> 160$.
  ]
]
