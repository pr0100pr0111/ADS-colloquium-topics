= Код

#listing(caption: [Очередь на односвязном списке])[
  ```cpp
  #include <cassert>

  class ListQueue {
  public:
      ListQueue() = default;
      ~ListQueue() { while (!Empty()) Pop(); }
      ListQueue(const ListQueue&) = delete;
      ListQueue& operator=(const ListQueue&) = delete;

      bool Empty() const { return head_ == nullptr; }
      int  Size()  const { return size_; }
      int  Front() const { assert(head_); return head_->val; }

      void Push(int x) {
          Node* n = new Node{x, nullptr};
          if (tail_) tail_->next = n; else head_ = n;   // пустая очередь: узел и голова
          tail_ = n;
          ++size_;
      }
      void Pop() {
          assert(head_);
          Node* t = head_;
          head_ = head_->next;
          if (!head_) tail_ = nullptr;                  // очередь опустела
          delete t;
          --size_;
      }

  private:
      struct Node {
          int val;
          Node* next;
      };
      Node* head_ = nullptr;
      Node* tail_ = nullptr;
      int size_ = 0;
  };
  ```
]

