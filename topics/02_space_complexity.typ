= Сложность и свойства

#facts(
  ([Память по классам], [
    #ptable(
      columns: (1fr, 3fr),
      align: left,
      header: ([Класс], [Типичная причина]),
      [$O(1)$], [Фиксированное число переменных; in-place],
      [$O(log n)$], [Рекурсия глубины $log n$ (рекурсивный бинарный поиск)],
      [$O(n)$], [Массив размера $n$ или рекурсия глубины $n$],
      [$O(n + k)$], [Счётчики размера $k$ плюс результат (сортировка подсчётом)],
      [$O(n^2)$], [Таблица $n times n$ (матрица смежности)],
    )
  ]),
  ([Зависит от случая], [Быстрая сортировка: стек $O(log n)$ при удачных разбиениях, $Theta(n)$ при плохих. Если сначала рекурсивно обрабатывать меньшую часть, глубина $<= log_2 n$ всегда.]),
  ([Время против памяти], [Мемоизация: память за время ($phi^n -> n$). Префиксные суммы: $Theta(n)$ памяти, запрос $O(1)$ вместо $Theta(n)$. Работа на месте: память за время, но не всегда.]),
  ([Структура данных], [Массив, `vector` ($Theta(n)$; при расширении пик $3n$: старый буфер $n$ + новый $2n$), связный список ($Theta(n)$ с большей константой), стек вызовов, таблица мемоизации, матрица $n times m$ — $Theta(n m)$.]),
  ([Ограничения], [Стек вызовов ограничен (несколько МБ): рекурсия глубины $10^5$–$10^6$ может переполнить стек, хотя $O(n)$. Считаются слова, а не байты. Накладные расходы (выравнивание, аллокатор) не моделируются. Хвостовая оптимизация не гарантирована стандартом C++.]),
  ([Применимость], [Когда память ограничена (типично 256 МБ). Ориентиры для `int`: массив $10^7$ — 40 МБ, матрица $5000 times 5000$ — 100 МБ, матрица $10^5 times 10^5$ — 40 ГБ (не поместится). Для графа со $10^5$ вершин годится список смежности, матрица — нет.]),
)

