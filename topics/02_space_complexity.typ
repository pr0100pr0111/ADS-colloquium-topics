= Код

#listing(caption: [Одна задача — разная память])[
  ```cpp
  void ReverseInPlace(int* a, int n) {          // O(1)
      for (int i = 0, j = n - 1; i < j; ++i, --j) std::swap(a[i], a[j]);
  }
  void ReverseWithBuffer(int* a, int n) {       // Theta(n): копия
      std::vector<int> t(a, a + n);
      for (int i = 0; i < n; ++i) a[i] = t[n - 1 - i];
  }
  long long FibIter(int n) {                    // время n, память O(1)
      long long a = 0, b = 1;
      for (int i = 0; i < n; ++i) { long long c = a + b; a = b; b = c; }
      return a;
  }
  int FactorialRec(int n) { return n <= 1 ? 1 : n * FactorialRec(n - 1); }  // Theta(n)
  ```
]

