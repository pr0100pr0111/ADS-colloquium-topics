= Код

#listing(caption: [Очередь с приоритетом с изменением приоритета])[
  ```cpp
  #include <cassert>
  #include <utility>
  #include <vector>

  class PriorityQueue {
  public:
      explicit PriorityQueue(int max_id) : pr_(max_id, 0), pos_(max_id, -1) {}

      bool Empty() const { return h_.empty(); }
      bool Contains(int id) const { return pos_[id] != -1; }
      int  TopId() const { assert(!h_.empty()); return h_[0]; }

      void Push(int id, int priority) {
          assert(pos_[id] == -1);
          pr_[id] = priority;
          pos_[id] = (int)h_.size();
          h_.push_back(id);
          SiftUp(pos_[id]);
      }
      int ExtractTop() {
          assert(!h_.empty());
          int top = h_[0];
          Swap(0, (int)h_.size() - 1);
          h_.pop_back();
          pos_[top] = -1;
          if (!h_.empty()) SiftDown(0);
          return top;
      }
      void ChangePriority(int id, int new_priority) {
          int i = pos_[id];
          assert(i != -1);
          int old = pr_[id];
          pr_[id] = new_priority;
          if (new_priority > old) SiftUp(i);       // повышение
          else                    SiftDown(i);     // понижение
      }

  private:
      bool Less(int i, int j) const { return pr_[h_[i]] < pr_[h_[j]]; }   // позиции в h
      void Swap(int i, int j) {
          std::swap(h_[i], h_[j]);
          pos_[h_[i]] = i;                          // обновляем таблицу позиций
          pos_[h_[j]] = j;
      }
      void SiftUp(int i) {
          while (i > 0) {
              int p = (i - 1) / 2;
              if (!Less(p, i)) break;
              Swap(p, i);
              i = p;
          }
      }
      void SiftDown(int i) {
          int n = (int)h_.size();
          while (true) {
              int l = 2 * i + 1, r = 2 * i + 2, big = i;
              if (l < n && Less(big, l)) big = l;
              if (r < n && Less(big, r)) big = r;
              if (big == i) break;
              Swap(i, big);
              i = big;
          }
      }

      std::vector<int> h_, pr_, pos_;
  };
  ```
]

