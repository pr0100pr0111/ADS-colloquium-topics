  #ptable(
    columns: (1.2fr, 1.2fr, 3.2fr, 1.8fr),
    align: (center, center, left, left),
    header: ([Длина $"len"$], [Отрезок $[l, r]$], [Варианты разбиения $k$], [$"dp"[l][r]$]),
    [$1$], [$[0, 0], [1, 1], [2, 2]$], [Базовые случаи: одна матрица], [$0, 0, 0$],
    [$2$], [$[0, 1]$ ($A_1 A_2$)], [$k=0: 0 + 0 + 10 dot 30 dot 5 = 1500$], [$1500$ ($k=0$)],
    [$2$], [$[1, 2]$ ($A_2 A_3$)], [$k=1: 0 + 0 + 30 dot 5 dot 60 = 9000$], [$9000$ ($k=1$)],
