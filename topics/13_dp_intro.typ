= Код

#listing(caption: [Фибоначчи: наивно, с мемоизацией, снизу вверх])[
  ```cpp
  #include <vector>

  long long FibNaive(int n) {                          // Θ(φ^n) вызовов
      return n <= 1 ? n : FibNaive(n - 1) + FibNaive(n - 2);
  }

  long long FibMemo(int n, std::vector<long long>& memo) {   // memo[i] = -1: не вычислено
      if (n <= 1) return n;
      if (memo[n] != -1) return memo[n];
      return memo[n] = FibMemo(n - 1, memo) + FibMemo(n - 2, memo);
  }
  // вызов: std::vector<long long> memo(n + 1, -1); FibMemo(n, memo);

  long long FibDp(int n) {                             // O(n) времени, O(1) памяти
      long long prev = 0, cur = 1;
      for (int i = 2; i <= n; ++i) {
          long long next = prev + cur;
          prev = cur;
          cur = next;
      }
      return n == 0 ? 0 : cur;
  }
  ```
]

