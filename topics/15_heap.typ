= Сложность и свойства

#facts(
  ([Время], [
    #ptable(
      columns: (2.4fr, 1.4fr, 3fr),
      header: ([Операция], [Время], [Комментарий]),
      [`Max` (чтение корня)], [$O(1)$], [Корень — максимум],
      [`SiftUp`, `SiftDown`], [$O(log n)$], [Не более высоты $floor(log_2 n)$ обменов],
      [`Insert`], [$O(log n)$], [Худший случай; на случайных данных в среднем $O(1)$],
      [`ExtractMax`], [$O(log n)$], [Один `SiftDown` от корня],
      [Построение из $n$ вставок], [$O(n log n)$], [Билет № 16: построение за $O(n)$],
      [Поиск произвольного элемента, минимум], [$Theta(n)$], [Порядок есть только между родителем и ребёнком],
    )
  ]),
  ([Память], [$Theta(n)$ — только массив, указателей нет; операции $O(1)$ дополнительной памяти (итеративные `SiftUp` и `SiftDown`).]),
  ([Структура данных], [Массив с неявным деревом: индексы определяют родителя и детей.]),
  ([Ограничения], [Не структура для поиска и не сортированный список: быстро доступен только максимум. Нельзя быстро найти элемент по значению (нужна вспомогательная таблица позиций). Не устойчива: равные элементы могут менять порядок. Для минимальной пирамиды достаточно перевернуть сравнения.]),
  ([Применимость], [Очередь с приоритетом (билет № 19); пирамидальная сортировка (билет № 17); $k$ наибольших элементов потока; алгоритм Дейкстры; слияние $k$ отсортированных списков; планировщики задач.]),
)

#remark[
  При нумерации с единицы формулы проще: родитель $floor(i slash 2)$, дети $2i$ и $2i + 1$.
  Здесь и в следующих билетах используется нумерация с нуля.
]

= Код

#listing(caption: [Максимальная пирамида на `std::vector`])[
  ```cpp
  #include <cassert>
  #include <utility>
  #include <vector>

  class MaxHeap {
  public:
      bool Empty() const { return a_.empty(); }
      int  Size()  const { return (int)a_.size(); }
      int  Max()   const { assert(!a_.empty()); return a_[0]; }

      void Insert(int x) {
          a_.push_back(x);
          SiftUp((int)a_.size() - 1);
      }
      int ExtractMax() {
          assert(!a_.empty());
          int top = a_[0];
          a_[0] = a_.back();             // последний элемент — в корень
          a_.pop_back();
          if (!a_.empty()) SiftDown(0);
          return top;
      }

  private:
      void SiftUp(int i) {
          while (i > 0) {
              int p = (i - 1) / 2;
              if (a_[p] >= a_[i]) break;
              std::swap(a_[p], a_[i]);
              i = p;
          }
      }
      void SiftDown(int i) {
          int n = (int)a_.size();
          while (true) {
              int l = 2 * i + 1, r = 2 * i + 2, big = i;
              if (l < n && a_[l] > a_[big]) big = l;
              if (r < n && a_[r] > a_[big]) big = r;
              if (big == i) break;
              std::swap(a_[i], a_[big]);
              i = big;
          }
      }

      std::vector<int> a_;
  };
  ```
]

= Вопросы экзаменатора

*Обязательные.*

#qa(
  ([Что такое пирамида (куча)?], [Полное бинарное дерево в массиве, где значение каждого узла не меньше значений детей (максимальная пирамида).]),
  ([Как найти родителя и детей по индексу?], [При нумерации с нуля: родитель $floor((i-1) slash 2)$, дети $2i + 1$, $2i + 2$.]),
  ([Где максимум и за сколько его получить?], [В корне `a[0]`: $O(1)$.]),
  ([Как вставить элемент?], [Дописать в конец и просеять вверх: $O(log n)$.]),
  ([Как извлечь максимум?], [Записать последний элемент в корень, уменьшить размер, просеять вниз: $O(log n)$.]),
  ([Чем `SiftUp` отличается от `SiftDown`?], [`SiftUp` поднимает элемент, который стал больше родителя; `SiftDown` опускает элемент, который стал меньше детей (с обменом на _большего_ ребёнка).]),
  ([Какая высота пирамиды из $n$ элементов?], [$floor(log_2 n)$: дерево полное.]),
  ([Какая память?], [$Theta(n)$ — только массив; указателей нет.]),
)

*С подвохом.*

#qa(
  ([Почему в `SiftDown` меняют с _большим_ ребёнком?], [Новый родитель должен быть не меньше обоих детей. Если обменять с меньшим, больший ребёнок окажется под меньшим родителем — свойство нарушится.]),
  ([Можно ли быстро найти минимум в максимальной пирамиде?], [Нет: минимум в одном из листьев (половина элементов), поиск $Theta(n)$.]),
  ([Какая сложность вставки в среднем?], [На случайных данных $O(1)$ в среднем (большинство элементов остаётся у листьев), но в худшем $O(log n)$, например при возрастающем входе.]),
  ([Почему для `ExtractMax` берут последний элемент, а не больший ребёнок корня?], [Последний лист снимается без нарушения формы дерева (полное дерево остаётся полным); потом свойство восстанавливается одним `SiftDown`.]),
  ([Устойчива ли пирамида?], [Нет: обмены родителя и ребёнка меняют относительный порядок равных элементов.]),
  ([Поддерживает ли быстрый поиск и удаление по значению?], [Нет: поиск $Theta(n)$. Удаление по _известному индексу_ — $O(log n)$ (билет № 18).]),
)

#appendix[
  #proposition[Высота пирамиды из $n$ элементов равна $floor(log_2 n)$.]
  #proof[
    На уровне $j$ (корень — уровень $0$) помещается не более $2^j$ узлов. Если высота равна $h$,
    то уровни $0, dots, h - 1$ заполнены ($2^h - 1$ узлов) и на уровне $h$ есть хотя бы один,
    поэтому $2^h <= n <= 2^(h+1) - 1$, откуда $h = floor(log_2 n)$.
  ]

  #proof(name: "Корректность `SiftUp` (инвариант)")[
    Инвариант перед итерацией: свойство пирамиды выполнено для всех пар «родитель — ребёнок»,
    кроме, возможно, пары (родитель $i$, $i$); и если у $i$ есть дети, то родитель $i$ не
    меньше этих детей. Пусть родитель $p$ меньше `a[i]`; после обмена: в $p$ стоит
    большее значение `a[i]`, оно не меньше «брата» $s$ узла $i$ (так как было $>= "a"[p] >= "a"[s]$),
    а в $i$ стоит прежнее `a[p]`, которое не меньше детей $i$ по второй части инварианта.
    Поэтому нарушиться может лишь пара (родитель $p$, $p$) — инвариант выполнен для $i := p$.
    При остановке пара $(p, i)$ в порядке, и пирамида корректна.
  ]

  #proof(name: "Корректность `SiftDown` (инвариант)")[
    Предусловие: поддеревья детей узла $i$ — пирамиды. Перед итерацией свойство выполнено
    везде, кроме, возможно, пар «$i$ — дети $i$». Выбор максимума из `a[i]` и детей и обмен
    ставят максимум в $i$: свойство для $i$ выполнено, а у места, куда ушёл прежний `a[i]`,
    поддеревья снова остаются пирамидами. Алгоритм завершается: индекс растёт и ограничен $n$.
  ]

  #proposition[`SiftUp` и `SiftDown` выполняют не более $floor(log_2 n)$ обменов.]
  #proof[
    На каждой итерации индекс перемещается на один уровень вверх (вниз). Уровней не больше
    $floor(log_2 n) + 1$, поэтому обменов не больше $floor(log_2 n)$. Каждая итерация — $O(1)$.
  ]
]
