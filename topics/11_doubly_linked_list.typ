  ([Структура данных], [Узлы в куче с двумя указателями; `head` и `tail`. На ней строят дек, LRU-кэш (вместе с хеш-таблицей), `std::list`.]),
  ([Ограничения], [Нет произвольного доступа. Больше памяти и больше указателей для согласованной перестройки при каждой вставке/удалении (легко сломать инвариант). Плохая локальность кэша, выделение на каждый узел. Ручное управление памятью.]),
  ([Применимость], [Нужно удалять и вставлять по известному узлу за $O(1)$ и ходить в обе стороны: дек, LRU-кэш (хеш-таблица хранит указатели на узлы, перемещение узла в голову — $O(1)$), редакторы текста, история переходов, итераторы `std::list`.]),
)

#pitfall(title: "Типичные ошибки")[
  - Забыть обновить `head` или `tail` при удалении или вставке на конце.
  - Обновить только одну из двух связей: нарушается инвариант `p->next->prev == p`.
  - Использовать `p` после `delete p` (в том числе в `PopBack`, если читать `tail->prev` после удаления).
  - Забыть освободить узлы в деструкторе — утечка.
]

= Код

#listing(caption: [Двусвязный список])[
  ```cpp
  #include <cassert>

  struct Node {
      int val;
      Node* prev;
      Node* next;
  };

  class DList {
  public:
      DList() = default;
      ~DList() { while (head_) PopFront(); }
      DList(const DList&) = delete;
      DList& operator=(const DList&) = delete;

      void PushFront(int x) {
          Node* n = new Node{x, nullptr, head_};
          if (head_) head_->prev = n; else tail_ = n;
          head_ = n;
          ++size_;
      }
      void PushBack(int x) {
          Node* n = new Node{x, tail_, nullptr};
          if (tail_) tail_->next = n; else head_ = n;
          tail_ = n;
          ++size_;
      }
      void InsertAfter(Node* p, int x) {
          Node* n = new Node{x, p, p->next};
          if (p->next) p->next->prev = n; else tail_ = n;
          p->next = n;
          ++size_;
      }
      void Erase(Node* p) {
          assert(p);
          if (p->prev) p->prev->next = p->next; else head_ = p->next;
          if (p->next) p->next->prev = p->prev; else tail_ = p->prev;
          delete p;
          --size_;
      }
      void PopFront() { assert(head_); Erase(head_); }
      void PopBack()  { assert(tail_); Erase(tail_); }
      Node* Find(int x) const {
          for (Node* p = head_; p; p = p->next)
              if (p->val == x) return p;
          return nullptr;
      }

  private:
      Node* head_ = nullptr;
      Node* tail_ = nullptr;
      int size_ = 0;
  };
  ```
]

