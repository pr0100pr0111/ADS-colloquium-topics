#pitfall(title: "Типичные ошибки")[
  - Обход `while (p != nullptr)` — бесконечный цикл: `nullptr` в кольце не встречается.
  - Не замкнуть единственный узел на себя при вставке в пустой список.
  - При удалении последнего узла оставить `tail`, указывающий на освобождённый узел.
  - Цикл обхода с условием `while (p != head)` пропускает первый узел: нужен `do-while`.
]

= Код

#listing(caption: [Циклический односвязный список с указателем `tail`])[
  ```cpp
  #include <cassert>

  struct Node {
      int val;
      Node* next;
  };

  class CircularList {
  public:
      CircularList() = default;
      ~CircularList() { while (!Empty()) PopFront(); }
      CircularList(const CircularList&) = delete;
      CircularList& operator=(const CircularList&) = delete;

      bool Empty() const { return tail_ == nullptr; }
      int  Size()  const { return size_; }
      int  Front() const { assert(tail_); return tail_->next->val; }

      void PushFront(int x) {
          Node* n = new Node{x, nullptr};
          if (!tail_) { n->next = n; tail_ = n; }
          else        { n->next = tail_->next; tail_->next = n; }
          ++size_;
      }
      void PushBack(int x) {
          PushFront(x);
          tail_ = tail_->next;               // новый узел стал хвостом
      }
      void PopFront() {
          assert(tail_);
          Node* h = tail_->next;
          if (h == tail_) tail_ = nullptr;   // был единственный узел
          else tail_->next = h->next;
          delete h;
          --size_;
      }
      void Rotate() { assert(tail_); tail_ = tail_->next; }   // голова уходит в конец

      long long Sum() const {                // обход ровно один круг
          if (!tail_) return 0;
          long long s = 0;
          Node* p = tail_->next;
          do { s += p->val; p = p->next; } while (p != tail_->next);
          return s;
      }

  private:
      Node* tail_ = nullptr;
      int size_ = 0;
  };

  int Josephus(int n, int k) {               // номер оставшегося, время O(n k)
      CircularList c;
      for (int i = 1; i <= n; ++i) c.PushBack(i);
      while (c.Size() > 1) {
          for (int s = 1; s < k; ++s) c.Rotate();
          c.PopFront();
      }
      return c.Front();
  }
  ```
]

