#remark[
  При нумерации с единицы: родитель равен $floor(i slash 2)$, дети — $2i$ и $2i + 1$. В данном курсе
  используется стандартная нумерация с нуля.
]

= Код

#listing(caption: [Максимальная пирамида с построением за O(n)])[
  ```cpp
  #include <cassert>
  #include <utility>
  #include <vector>

  class MaxHeap {
  public:
      MaxHeap() = default;

      // Построение пирамиды за Theta(n) методом Флойда
      explicit MaxHeap(std::vector<int> a) : a_(std::move(a)) {
          for (int i = (int)a_.size() / 2 - 1; i >= 0; --i) {
              SiftDown(i);
          }
      }

      bool Empty() const { return a_.empty(); }
      int  Size()  const { return (int)a_.size(); }
      int  Max()   const { assert(!a_.empty()); return a_[0]; }

      void Insert(int x) {
          a_.push_back(x);
          SiftUp((int)a_.size() - 1);
      }

      int ExtractMax() {
          assert(!a_.empty());
          int top = a_[0];
          a_[0] = a_.back();
          a_.pop_back();
          if (!a_.empty()) SiftDown(0);
          return top;
      }

  private:
      void SiftUp(int i) {
          while (i > 0) {
              int p = (i - 1) / 2;
              if (a_[p] >= a_[i]) break;
              std::swap(a_[p], a_[i]);
              i = p;
          }
      }

      void SiftDown(int i) {
          int n = (int)a_.size();
          while (true) {
              int l = 2 * i + 1, r = 2 * i + 2, big = i;
              if (l < n && a_[l] > a_[big]) big = l;
              if (r < n && a_[r] > a_[big]) big = r;
              if (big == i) break;
              std::swap(a_[i], a_[big]);
              i = big;
          }
      }

      std::vector<int> a_;
  };
  ```
]

