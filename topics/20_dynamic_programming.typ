= Код

#listing(
  caption: [Кузнечик ($O(n k)$), рюкзак 0-1 со сжатием памяти ($O(n W)$) и НВП за $O(n log n)$ с восстановлением],
)[
  ```cpp
  #include <algorithm>
  #include <limits>
  #include <vector>

  // 1. Кузнечик: макс. стоимость пути из 0 в n с прыжками 1..k и восстановлением маршрута
  std::pair<long long, std::vector<int>> Grasshopper(const std::vector<long long>& c, int k) {
      int n = (int)c.size() - 1;
      const long long INF = std::numeric_limits<long long>::min() / 2;
      std::vector<long long> dp(n + 1, INF);
      std::vector<int> prev(n + 1, -1);
      dp[0] = c[0];
      for (int i = 1; i <= n; ++i) {
          for (int j = 1; j <= std::min(i, k); ++j) {
              if (dp[i - j] > dp[i]) {
                  dp[i] = dp[i - j];
                  prev[i] = i - j;
              }
          }
          dp[i] += c[i];
      }
      std::vector<int> path;
      for (int cur = n; cur != -1; cur = prev[cur]) path.push_back(cur);
      std::reverse(path.begin(), path.end());
      return {dp[n], path};
  }

  // 2. Рюкзак 0-1: макс. ценность за O(n * W) по времени и O(W) по памяти
  long long Knapsack01(int W, const std::vector<int>& w, const std::vector<long long>& v) {
      std::vector<long long> dp(W + 1, 0);
      for (size_t i = 0; i < w.size(); ++i) {
          for (int cur_w = W; cur_w >= w[i]; --cur_w) {          // строго справа налево!
              dp[cur_w] = std::max(dp[cur_w], dp[cur_w - w[i]] + v[i]);
          }
      }
      return dp[W];
  }

  // 3. НВП (LIS) за O(n log n) с полным восстановлением подпоследовательности
  std::vector<int> LIS(const std::vector<int>& a) {
      int n = (int)a.size(), len = 0;
      const int INF = std::numeric_limits<int>::max();
      std::vector<int> tail(n + 1, INF), tail_id(n + 1, -1), prev(n, -1);
      tail[0] = std::numeric_limits<int>::min();
      for (int i = 0; i < n; ++i) {
          int pos = (int)(std::lower_bound(tail.begin(), tail.end(), a[i]) - tail.begin());
          tail[pos] = a[i];
          tail_id[pos] = i;
          prev[i] = tail_id[pos - 1];                           // предок в цепочке длины pos - 1
          len = std::max(len, pos);
      }
      std::vector<int> res;
      for (int cur = tail_id[len]; cur != -1; cur = prev[cur]) res.push_back(a[cur]);
      std::reverse(res.begin(), res.end());
      return res;
  }
  ```
]

