= Код

#listing(caption: [QuickSelect: схема Ломуто, случайный опорный, цикл])[
  ```cpp
  #include <cstdlib>
  #include <utility>

  int Partition(int* a, int l, int r) {          // [l, r], опорный a[r]; см. билет № 5
      int pivot = a[r];
      int i = l;
      for (int j = l; j < r; ++j) {
          if (a[j] < pivot) std::swap(a[i++], a[j]);
      }
      std::swap(a[i], a[r]);
      return i;                                   // итоговая позиция опорного
  }

  // k с нуля. Возвращает значение k-й порядковой статистики; массив переставляется.
  int QuickSelect(int* a, int n, int k) {
      int l = 0, r = n - 1;
      while (l < r) {
          std::swap(a[l + std::rand() % (r - l + 1)], a[r]);   // случайный опорный
          int m = Partition(a, l, r);
          if (k == m) return a[m];
          if (k < m) r = m - 1;
          else       l = m + 1;
      }
      return a[l];                                // l == r == k
  }
  ```
]

